{
  "name": "crownline-logistics",
  "version": "0.1.0",
  "private": true,
  "description": "Crownline Express — shipping coordination, quotes, tracking and operations platform",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "migrate": "node --env-file-if-exists=.env src/scripts/migrate.ts",
    "user:create": "node --env-file-if-exists=.env src/scripts/create-user.ts",
    "seed:demo": "node --env-file-if-exists=.env src/scripts/seed-demo.ts",
    "assets:optimize": "node src/scripts/optimize-images.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "express": "^5.3.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
