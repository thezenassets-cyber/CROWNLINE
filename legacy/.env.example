# LIVEXPRESS - Environment Variables
# Copy this file to .env and fill in YOUR values for this company only.
# Do not copy secrets from another site.

COMPANY_NAME=LIVEXPRESS
SITE_URL=http://localhost:3000
# Comma-separated additional website origins, if needed
# CORS_ORIGINS=https://your-company.example,https://www.your-company.example
# INDEXNOW_KEY=

# === SMTP Email Config ===
# Option 1: Brevo (recommended - free, easy setup)
#   Sign up at brevo.com → Settings → SMTP & API → SMTP
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your-brevo-login-email
EMAIL_PASSWORD=your-brevo-smtp-key

# Option 2: Gmail (requires App Password + 2FA)
#   Remove EMAIL_HOST and EMAIL_PORT lines
# EMAIL_USER=your-gmail@gmail.com
# EMAIL_PASSWORD=your-app-password

# Option 3: Any SMTP provider
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-username
# EMAIL_PASSWORD=your-password

# Admin panel password (SHA-256 authentication)
ADMIN_PASSWORD=ChangeMeLocalOnly

# === Shipment database (REQUIRED for customer tracking in production) ===
# Separate variables avoid URI-encoding issues:
# MONGODB_USER=myuser
# MONGODB_PASSWORD=YOUR_DB_PASSWORD
# MONGODB_CLUSTER=cluster0.xxxxx.mongodb.net
# MONGODB_DB=livexpress
#
# OR one line (password must NOT use < > brackets):
# MONGODB_URI=mongodb+srv://myuser:YOUR_DB_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# === Search engine verification ===
# Search Console → HTML tag → copy only the content value:
# GOOGLE_SITE_VERIFICATION=your_verification_code_here
# GA4 from https://analytics.google.com (optional):
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
