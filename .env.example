# Crownline Logistics — environment configuration
# Copy to .env and fill in values for your environment. Never commit .env.
# Every value below is a placeholder. The server validates this file at startup
# and refuses to start in production when a required secret is missing.

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public base URL. Must be https:// in production (https://crownlineexpress.org).
# Cookies are marked Secure (and use the __Host- prefix) whenever this starts with https://.
SITE_URL=http://localhost:3000
# Number of trusted reverse-proxy hops in front of the app (0 = none).
TRUST_PROXY=0
# debug | info | warn | error
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# PostgreSQL connection string. Required in production.
# DATABASE_URL=postgres://crownline_app:REPLACE_ME@db.example.internal:5432/crownline
# require | disable  (use "disable" only for a local database without TLS)
DATABASE_SSL=require
# Without DATABASE_URL the app uses an embedded PGlite database (development/test).
# Production refuses to start without DATABASE_URL unless this is "true"
# (single-instance demonstrations only).
ALLOW_EMBEDDED_DB=false
EMBEDDED_DB_DIR=.data/pglite

# --- Tracking codes --------------------------------------------------------
# HMAC key for hashing public tracking codes. 32+ random characters. Required in
# production. Rotating it invalidates every issued tracking code.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TRACKING_CODE_SECRET=
# Days until a newly issued tracking code expires (0 = no expiry).
TRACKING_CODE_TTL_DAYS=0

# --- Pricing ---------------------------------------------------------------
# demo      = sample figures, always labelled as a demonstration (default outside production)
# rate_card = owner-approved rate card loaded from RATE_CARD_PATH
# disabled  = billable weight only, no prices (default in production)
# PRICING_MODE=demo
# RATE_CARD_PATH=/secure/config/rate-card.json

# --- Company details (shown only when set; nothing is invented) -------------
# COMPANY_LEGAL_NAME=
# COMPANY_EMAIL=
# COMPANY_PHONE=
# COMPANY_ADDRESS=

# --- Integrations (not yet implemented; settings shows "Not configured") ---
# MAPBOX_PUBLIC_TOKEN=
# EMAIL_PROVIDER=
# PAYMENT_PROVIDER=
